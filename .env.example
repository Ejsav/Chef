# Public canonical origin — used for metadata, sitemap, and JSON-LD.
# Leave empty on Vercel until the real domain is live; the project's
# production address is used automatically.
NEXT_PUBLIC_SITE_URL=

# Public contact inbox and Instagram handle (without @). Hidden while empty.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM=

# Optional. When set, inquiries are emailed through Resend (https://resend.com).
# Without it, the API validates and logs the inquiry server-side only.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=

# Signs private invitation links (/invite/<token>). Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INVITE_SECRET=

# Optional: Plausible Analytics domain (Vercel Analytics works with no config on Vercel).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
